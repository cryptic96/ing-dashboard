@page "/account/login"
@model Ledger.Service.Pages.Account.LoginModel
@{
    Layout = "_SignInLayout";
    ViewData["Title"] = "Sign in";
}
<h1>Sign in</h1>
@if (Model.SignedIn)
{
    <p>You are signed in. You can close this window.</p>
}
else
{
    @if (Model.Failed)
    {
        <p class="error" role="alert">Sign-in failed.</p>
    }
    <form method="post">
        <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl">
        <label for="UserName">User name</label>
        <input id="UserName" name="UserName" type="text" autocomplete="username" autocapitalize="none" spellcheck="false" required>
        <label for="Password">Password</label>
        <input id="Password" name="Password" type="password" autocomplete="current-password" required>
        <button type="submit">Sign in</button>
    </form>
}
