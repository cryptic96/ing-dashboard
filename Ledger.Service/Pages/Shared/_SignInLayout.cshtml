@{
    var nonce = Context.Items[Ledger.Service.OAuth.SignInPageHeaders.StyleNonceItemKey] as string;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <title>@ViewData["Title"] - Household Ledger</title>
    <style nonce="@nonce">
        :root { color-scheme: light dark; }
        body { margin: 0; min-height: 100vh; display: grid; place-items: center; font-family: system-ui, -apple-system, "Segoe UI", sans-serif; line-height: 1.5; background: Canvas; color: CanvasText; }
        main { width: min(28rem, 100% - 2rem); padding: 1.5rem 1.75rem; border: 1px solid GrayText; border-radius: 0.5rem; }
        h1 { margin: 0 0 1rem; font-size: 1.35rem; }
        label { display: block; margin-top: 0.75rem; font-weight: 600; }
        input[type="text"], input[type="password"] { box-sizing: border-box; width: 100%; margin-top: 0.25rem; padding: 0.5rem; font: inherit; }
        button { margin-top: 1.25rem; margin-right: 0.5rem; padding: 0.5rem 1.1rem; font: inherit; cursor: pointer; }
        ul { padding-left: 1.25rem; }
        .error { color: #b00020; font-weight: 600; }
        dl { margin: 0 0 1rem; }
        dt { font-weight: 600; margin-top: 0.5rem; }
        dd { margin: 0; overflow-wrap: anywhere; }
    </style>
</head>
<body>
    <main>
        @RenderBody()
    </main>
</body>
</html>
