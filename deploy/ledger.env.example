ASPNETCORE_ENVIRONMENT=Production

# The address the reverse proxy connects from; the deployed value replaces this placeholder.
ReverseProxy__KnownProxies__0=192.0.2.10

# Provisioning generates the Data Protection certificate and its password; copy both to the
# password manager. They are not included in backups.
DataProtection__CertificatePath=/etc/ledger/dataprotection.pfx
DataProtection__CertificatePassword=generated-by-provisioning

# The application serves the reverse proxy over https on port 5080 using the certificate and key provisioning generates
# at /etc/ledger/backend-tls.crt and /etc/ledger/backend-tls.key (the paths are part of the shipped production settings, so
# nothing needs setting here). The reverse proxy trusts exactly that certificate; copy only the public .crt file to it, never
# the key. The application refuses to start in production without both files.

# The public address of the MCP host. Setting it switches on sign-in, the OAuth endpoints and /mcp; it must be https with
# no path or trailing slash. Sign-in pages answer only to the ranges below (home network and VPN, CIDR notation);
# the deployed values replace these placeholders.
OAuth__PublicBaseUrl=https://mcp.example.com
OAuth__SignInNetworks__0=192.0.2.0/24
OAuth__SignInNetworks__1=198.51.100.0/24

# The bank link. ledger-bank-key generate and ledger-bank-key configure write the real values on
# the host; these lines only show which settings exist. Copy the key file and this file into the
# password manager. They are not included in backups.
# Ingestion__Provider=EnableBanking
# EnableBanking__ApplicationId=00000000-0000-0000-0000-000000000000
# EnableBanking__PrivateKeyPath=/etc/ledger/enablebanking-key.pem
# EnableBanking__PrivateKeyPassword=generated-by-ledger-bank-key
# BankLink__RedirectUrl=https://ledger-api.example.com/api/v1/bank/callback
