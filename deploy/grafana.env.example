# The real file is /etc/ledger/grafana.env, owned by root, group grafana,
# mode 640. It is loaded by the grafana-server systemd drop-in
# (deploy/systemd/grafana-server.service.d/ledger.conf) and holds every
# server-specific Grafana value that must never live in this repository.

GF_SERVER_DOMAIN=grafana.example.com
GF_SERVER_ROOT_URL=https://grafana.example.com/
GF_SMTP_ENABLED=true
GF_SMTP_HOST=smtp-relay.example.com:25
GF_SMTP_FROM_ADDRESS=ledger-alerts@example.com
GF_SMTP_FROM_NAME=Household Ledger
GF_SMTP_STARTTLS_POLICY=MandatoryStartTLS

# Where the operator-email contact point sends alerts (deploy/provisioning/
# grafana/provisioning/alerting/contact-points.yaml interpolates this).
LEDGER_ALERT_EMAIL=operator@example.com
