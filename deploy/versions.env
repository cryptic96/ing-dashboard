# Install source pins consumed by provision.sh and its modules.
# Every value here was checked against its real source by
# deploy/tests/versions-network-test.sh. Re-run that script whenever a pin
# is bumped, and record the values it confirms back into this file.
# Last confirmed against real sources: 2026-09-27.

# PostgreSQL: installed from the PGDG apt repository (noble-pgdg), not the
# Ubuntu default repo, so the major version stays current instead of frozen
# at whatever Ubuntu 24.04 shipped with.
PG_MAJOR=18
PGDG_KEY_URL=https://www.postgresql.org/media/keys/ACCC4CF8.asc
PGDG_KEY_FINGERPRINT=B97B0AFCAA1A47F044F244A07FCC7D46ACCC4CF8

# .NET ASP.NET Core runtime: comes from Ubuntu's own noble-updates archive;
# the Microsoft package feed does not publish a 24.04 build.
DOTNET_RUNTIME_PACKAGE=aspnetcore-runtime-10.0

# Grafana: pinned to a specific minor line via an apt preferences pin so
# unattended-upgrades never jumps a major/minor unexpectedly.
GRAFANA_VERSION_PIN=13.2.2
GRAFANA_KEY_URL=https://apt.grafana.com/gpg.key
GRAFANA_KEY_FINGERPRINT=B53AE77BADB630A683046005963FA27710458545
GRAFANA_SERVICE_USER=grafana

# Prometheus: installed from the upstream release tarball (no apt repo),
# checksum-verified before extraction. Tracking the LTS line.
PROMETHEUS_VERSION=3.13.3
PROMETHEUS_SHA256=b349c732d8a853e657d0e7ae1bbad4d11b586615fb65fdc59d896b9f869c001e

# GitHub CLI: needed for offline attestation verification (gh attestation
# verify --bundle); the version floor is the first release with that flag.
GH_CLI_KEY_URL=https://cli.github.com/packages/githubcli-archive-keyring.gpg
GH_CLI_KEY_FINGERPRINT=7F38BBB59D064DBCB3D84D725612B36462313325
GH_CLI_MIN_VERSION=2.49.0
