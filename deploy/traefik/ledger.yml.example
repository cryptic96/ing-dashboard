# Traefik v3 dynamic (file-provider) configuration for the household
# ledger platform. This file is not read by anything in this repository —
# copy it into the existing Traefik container's dynamic configuration
# directory (the directory its file provider already watches) and replace
# every placeholder below with the household's own values.
#
# Three hostnames are routed here:
#
#   grafana.example.com    the dashboards, home network and VPN only.
#   ledger-api.example.com the REST API under /api/, home network and VPN
#                          only.
#   mcp.example.com        the dedicated MCP hostname. Exactly five paths
#                          are public: /mcp, the protected-resource
#                          document, the two authorization-server
#                          discovery documents and /connect/token. They
#                          are reachable from Anthropic's published
#                          outbound range plus the home network and VPN.
#                          The sign-in paths, /connect/authorize and
#                          everything under /account/, are reachable from
#                          the home network and VPN only.
#
# Every path on the MCP hostname is matched exactly (or, for the sign-in
# pages, by one fixed prefix). There is no route for the REST API, the
# metrics, the health endpoint or any dashboard on the MCP hostname, and
# none for /mcp or the sign-in paths on the other two hostnames. The
# application enforces the same lists a second time and answers 404 for
# anything else. This file has no route at all for any operational or
# loopback-only endpoint.
#
# DNS: the MCP hostname needs a public IPv4 A record that is DNS-only
# (not proxied by the DNS provider) and no AAAA record, plus a local DNS
# record pointing home network and VPN clients at this Traefik instance,
# so there is one issuer and one resource URL for every client.
#
# Rollout is staged: first install the public router with the
# ledger-lan-vpn-only middleware instead of ledger-mcp-allow, prove the
# whole flow from home or VPN, and only at go-live switch it to
# ledger-mcp-allow.
#
# The allowlists must judge the TCP peer address itself. Never set any
# option that makes them read an address from a forwarded header, and
# keep the router in front of Traefik free of source address
# translation, otherwise every client looks like the same address or a
# forged header decides who gets in.
#
# No middleware that holds back or collects a response may sit in front
# of /mcp: replies are streamed and would stall.
#
# The address allowlist is defence in depth. OAuth is the real control:
# every /mcp request needs a valid access token regardless of where it
# comes from.
#
# The application trusts forwarded headers (X-Forwarded-For) only from
# the address configured as ReverseProxy__KnownProxies__0 in the
# server-side application environment file — that value must be this
# Traefik container's own address.
#
# Every hostname and address below is a placeholder from the
# documentation ranges (RFC 5737) or an example.* domain; replace all of
# them, never commit a real value here.

http:
  middlewares:
    ledger-lan-vpn-only:
      ipAllowList:
        sourceRange:
          # Replace with the household's real LAN subnet.
          - "192.0.2.0/24"
          # Replace with the household's real VPN subnet.
          - "198.51.100.0/24"

    ledger-mcp-allow:
      ipAllowList:
        sourceRange:
          # Anthropic's published outbound range for connector traffic.
          # Re-check it against Anthropic's IP address page before each
          # release (build/tests/anthropic-ranges-network-test.sh).
          - "160.79.104.0/21"
          # Replace with the household's real LAN subnet.
          - "192.0.2.0/24"
          # Replace with the household's real VPN subnet.
          - "198.51.100.0/24"

    ledger-security-headers:
      headers:
        stsSeconds: 31536000
        stsIncludeSubdomains: true
        stsPreload: true
        contentTypeNosniff: true
        frameDeny: true
        referrerPolicy: "strict-origin-when-cross-origin"

  routers:
    ledger-grafana:
      rule: "Host(`grafana.example.com`)"
      entryPoints:
        - websecure
      middlewares:
        - ledger-lan-vpn-only
        - ledger-security-headers
      service: ledger-grafana
      tls:
        certResolver: letsencrypt

    ledger-api:
      rule: "Host(`ledger-api.example.com`) && PathPrefix(`/api/`)"
      entryPoints:
        - websecure
      middlewares:
        - ledger-lan-vpn-only
        - ledger-security-headers
      service: ledger-api
      tls:
        certResolver: letsencrypt

    ledger-mcp-public:
      rule: "Host(`mcp.example.com`) && (Path(`/mcp`) || Path(`/.well-known/oauth-protected-resource/mcp`) || Path(`/.well-known/oauth-authorization-server`) || Path(`/.well-known/openid-configuration`) || Path(`/connect/token`))"
      priority: 100
      entryPoints:
        - websecure
      middlewares:
        - ledger-mcp-allow
        - ledger-security-headers
      service: ledger-api
      tls:
        certResolver: letsencrypt

    ledger-mcp-signin:
      rule: "Host(`mcp.example.com`) && (Path(`/connect/authorize`) || PathPrefix(`/account/`))"
      priority: 110
      entryPoints:
        - websecure
      middlewares:
        - ledger-lan-vpn-only
        - ledger-security-headers
      service: ledger-api
      tls:
        certResolver: letsencrypt

  services:
    ledger-grafana:
      loadBalancer:
        servers:
          # Replace with the ledger host's real address, port 3000 (Grafana).
          - url: "http://192.0.2.20:3000"

    ledger-api:
      loadBalancer:
        servers:
          # Replace with the ledger host's real address, port 5080 (REST API
          # and MCP endpoint).
          - url: "http://192.0.2.20:5080"
